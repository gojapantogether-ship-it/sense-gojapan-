    }

    let isSpeaking = false;
    
    function stopSpeech() {
      if ('speechSynthesis' in window) window.speechSynthesis.cancel();
      isSpeaking = false;
      const eq = document.getElementById('audio-visualizer');
      if (eq) eq.classList.remove('eq-playing');
    }

    function speakJapaneseScript(turns, rate = 1.0, onEndCallback = null) {
      if (!('speechSynthesis' in window)) {
        showToast('Browser Anda tidak mendukung fitur audio.', '⚠️');
        if(onEndCallback) onEndCallback();
        return;
      }
      
      stopSpeech();
      isSpeaking = true;
      const eq = document.getElementById('audio-visualizer');
      if (eq) eq.classList.add('eq-playing');

      const voices = window.speechSynthesis.getVoices().filter(v => v.lang && v.lang.toLowerCase().includes('ja'));
      let idx = 0;

      function nextTurn() {
        if (!isSpeaking || idx >= turns.length) {
          isSpeaking = false;
          if (eq) eq.classList.remove('eq-playing');
          if (onEndCallback) onEndCallback();
          return;
        }
        
        const t = turns[idx];
        const utter = new SpeechSynthesisUtterance(t.text);
        utter.lang = 'ja-JP';
        utter.rate = rate;
        
        if (voices.length > 0) {
            utter.voice = (t.speaker === 'M' && voices.length > 1) ? voices[1] : voices[0];
        }
        
        utter.pitch = t.speaker === 'M' ? 0.9 : 1.1;
        
        utter.onend = () => { 
            idx++; 
            setTimeout(nextTurn, 300); 
        };
        utter.onerror = () => { 
            isSpeaking = false; 
            if (eq) eq.classList.remove('eq-playing'); 
            if (onEndCallback) onEndCallback();
        };
        
        window.speechSynthesis.speak(utter);
      }
      
      nextTurn();
    }

    // =========================================================================
    // 4. EXAM WORKFLOW
    // =========================================================================
    function startExam() {
      const nameInput = document.getElementById('candidate-name');
      const err = document.getElementById('name-error');
      const name = nameInput.value.trim();
      if (!name) {
        err.classList.remove('hidden');
        nameInput.focus();
        return;
      }
      err.classList.add('hidden');

      state.candidateName = name;
      state.examId = `JLPT-FREE-${Math.floor(100000 + Math.random() * 900000)}`;
      state.userAnswers = {};
      state.flaggedQuestions = {};
      state.audioPlayCounts = {};
      state.currentIndex = 0;
      state.secondsRemaining = 40 * 60;

      generateExamPacket();

      document.getElementById('exam-candidate-display').textContent = state.candidateName;
      document.getElementById('exam-id-display').textContent = `ID: ${state.examId}`;

      switchView('view-exam');
      renderNavigatorGrid();
      renderCurrentQuestion();
      startTimer();
      showToast('Ujian dimulai! Semoga sukses.', '⛩️');
    }

    function switchView(id) {
      stopSpeech();
      ['view-lobby', 'view-exam', 'view-result'].forEach(v => {
        const el = document.getElementById(v);
        if (v === id) { el.classList.remove('hidden'); el.classList.add('flex'); }
        else { el.classList.add('hidden'); el.classList.remove('flex'); }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function startTimer() {
      clearInterval(state.timerInterval);
      updateTimerUI();
      state.timerInterval = setInterval(() => {
        state.secondsRemaining--;
        updateTimerUI();
        if (state.secondsRemaining <= 0) {
          clearInterval(state.timerInterval);
          showToast('Waktu habis! Jawaban dikumpulkan otomatis.', '⏱️');
          submitExam();
        }
      }, 1000);
    }

    function updateTimerUI() {
      const m = Math.floor(Math.max(0, state.secondsRemaining) / 60);
      const s = Math.max(0, state.secondsRemaining) % 60;
      document.getElementById('timer-display').textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    }

    function renderCurrentQuestion() {
      // Hentikan audio jika berpindah soal
      stopSpeech();
      
      const idx = state.currentIndex;
      const q = state.examQuestions[idx];
      if (!q) return;

      document.getElementById('q-number-badge').textContent = `Soal ${idx + 1} / 30`;
      document.getElementById('q-category-badge').textContent = q.categoryLabel;

      const flagBtn = document.getElementById('btn-flag-question');
      const isF = !!state.flaggedQuestions[idx];
      flagBtn.className = isF 
        ? 'px-3.5 py-1.5 rounded-xl bg-goldJp/25 border-2 border-goldJp text-amber-900 text-xs font-extrabold flex items-center gap-1.5 transition'
        : 'px-3.5 py-1.5 rounded-xl border border-slate-300 text-slate-600 hover:border-goldJp text-xs font-bold flex items-center gap-1.5 transition';
      document.getElementById('flag-icon').textContent = isF ? '🚩' : '🏳️';
      document.getElementById('flag-text').textContent = isF ? 'Ragu-ragu' : 'Tandai Ragu-ragu';

      const stimulus = document.getElementById('question-stimulus-area');
      stimulus.innerHTML = '';

      if (q.category === 'dokkai') {
        stimulus.innerHTML = `
          <div class="bg-[#FDFBF7] border-2 border-indigoJp/20 rounded-2xl p-4 sm:p-5 shadow-inner">
            <div class="font-jp font-bold text-sm text-indigoJp mb-2">${q.title}</div>
            <div class="font-jp text-base text-slate-800 leading-relaxed whitespace-pre-line">${q.passage}</div>
          </div>
        `;
      } else if (q.category === 'choukai') {
        const used = state.audioPlayCounts[idx] || 0;
        const left = Math.max(0, 2 - used);
        const exhausted = left === 0;
        
        stimulus.innerHTML = `
          <div class="bg-indigoJp text-white rounded-2xl p-4 border border-goldJp/50 shadow">
            <div class="flex items-center justify-between mb-2 text-xs">
              <span class="font-bold text-goldLight">🎧 Audio Sesi Mendengarkan (Maks 2x)</span>
              <span id="audio-left-badge" class="px-2.5 py-0.5 rounded-full ${exhausted ? 'bg-red-500/30 text-red-200' : 'bg-emerald-500/30 text-emerald-200'}">Sisa: ${left}/2</span>
            </div>
            <p class="font-jp text-sm text-slate-100 bg-white/10 p-3 rounded-xl mb-3"><strong>Situasi:</strong> ${q.situation}</p>
            <div class="flex items-center gap-3">
              <button type="button" id="btn-play" ${exhausted ? 'disabled' : ''} class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 ${exhausted ? 'bg-slate-600 text-slate-300' : 'bg-goldJp text-indigoJp hover:bg-amber-400'}">
                <span>${exhausted ? '🔒' : '▶️'}</span><span>${exhausted ? 'Batas Habis' : 'Putar Audio'}</span>
              </button>
              <div id="audio-visualizer" class="flex items-center gap-1 h-6 px-2"><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div></div>
            </div>
          </div>
        `;
        
        const pBtn = document.getElementById('btn-play');
        const badge = document.getElementById('audio-left-badge');
        
        if (pBtn && !exhausted) {
          pBtn.onclick = () => {
            // Update the play count
            state.audioPlayCounts[idx] = (state.audioPlayCounts[idx] || 0) + 1;
            const currentLeft = Math.max(0, 2 - state.audioPlayCounts[idx]);
            
            // Update UI elements manually without re-rendering the whole component
            badge.textContent = `Sisa: ${currentLeft}/2`;
            if(currentLeft === 0) {
                badge.classList.replace('bg-emerald-500/30', 'bg-red-500/30');
                badge.classList.replace('text-emerald-200', 'text-red-200');
            }
            
            pBtn.disabled = true;
            pBtn.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 bg-slate-600 text-slate-300';
            pBtn.innerHTML = '<span>🔊</span><span>Sedang Diputar...</span>';
            
            // Play Audio
            speakJapaneseScript(q.script, 1.0, () => {
                // Audio has ended
                if (currentLeft > 0) {
                    pBtn.disabled = false;
                    pBtn.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 bg-goldJp text-indigoJp hover:bg-amber-400';
                    pBtn.innerHTML = '<span>▶️</span><span>Putar Audio</span>';
                } else {
                    pBtn.disabled = true;
                    pBtn.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 bg-slate-600 text-slate-300';
                    pBtn.innerHTML = '<span>🔒</span><span>Batas Habis</span>';
                }
            });
          };
        }
      }

      document.getElementById('question-prompt-jp').innerHTML = q.q;
      document.getElementById('question-subprompt').textContent = q.sub || 'Pilih jawaban yang paling tepat:';

      const optContainer = document.getElementById('options-container');
      optContainer.innerHTML = '';
      const letters = ['A', 'B', 'C', 'D'];
      const sel = state.userAnswers[idx];

      q.opts.forEach((optText, oIdx) => {
        const isSel = sel === oIdx;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `w-full text-left p-3.5 rounded-xl border-2 transition flex items-center gap-3.5 ${isSel ? 'border-indigoJp bg-indigoJp/5' : 'border-slate-200 bg-white hover:border-indigoJp/40'}`;
        b.innerHTML = `
          <span class="w-8 h-8 rounded-lg flex items-center justify-center font-extrabold text-xs shrink-0 ${isSel ? 'bg-indigoJp text-goldLight' : 'bg-slate-100 text-slate-700'}">${letters[oIdx]}</span>
          <span class="font-jp text-base font-medium text-slate-800">${optText}</span>
        `;
        b.onclick = () => {
          state.userAnswers[idx] = oIdx;
          // Memanggil renderCurrentQuestion di sini aman, 
          // karena tombol Putar Audio tidak menggunakan userAnswers, 
          // namun agar audio tidak terpotong saat menjawab, 
          // kita tidak me-render ulang seluruh soal. Kita hanya update tombol pilihan.
          updateOptionsSelection(idx);
          renderNavigatorGrid();
        };
        optContainer.appendChild(b);
      });

      document.getElementById('btn-prev-q').disabled = idx === 0;
      const nextBtn = document.getElementById('btn-next-q');
      if (idx === 29) {
        nextBtn.innerHTML = '<span>Kumpulkan</span><span>✓</span>';
        nextBtn.className = 'px-6 py-3 rounded-xl bg-torii hover:bg-toriiDark text-white font-bold text-sm flex items-center gap-2 shadow transition';
      } else {
        nextBtn.innerHTML = '<span>Berikutnya</span><span>→</span>';
        nextBtn.className = 'px-6 py-3 rounded-xl bg-indigoJp hover:bg-indigoLight text-white font-bold text-sm flex items-center gap-2 shadow transition';
      }

      renderNavigatorGrid();
    }
    
    // Fungsi khusus agar saat memilih jawaban, audio tidak ter-reset
    function updateOptionsSelection(idx) {
        const container = document.getElementById('options-container');
        const sel = state.userAnswers[idx];
        Array.from(container.children).forEach((btn, oIdx) => {
            const isSel = sel === oIdx;
            btn.className = `w-full text-left p-3.5 rounded-xl border-2 transition flex items-center gap-3.5 ${isSel ? 'border-indigoJp bg-indigoJp/5' : 'border-slate-200 bg-white hover:border-indigoJp/40'}`;
            btn.children[0].className = `w-8 h-8 rounded-lg flex items-center justify-center font-extrabold text-xs shrink-0 ${isSel ? 'bg-indigoJp text-goldLight' : 'bg-slate-100 text-slate-700'}`;
        });
    }

    function renderNavigatorGrid() {
      const grid = document.getElementById('nav-grid');
      grid.innerHTML = '';
      const answered = Object.keys(state.userAnswers).length;
      document.getElementById('answered-counter').textContent = `Terjawab: ${answered} / 30`;

      state.examQuestions.forEach((q, i) => {
        const active = i === state.currentIndex;
        const ans = state.userAnswers[i] !== undefined;
        const flag = !!state.flaggedQuestions[i];

        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = i + 1;
        let cls = 'h-9 rounded-lg font-bold text-xs transition flex items-center justify-center ';
        if (active) cls += 'ring-2 ring-torii ring-offset-1 ';
        if (flag) cls += 'bg-goldJp text-indigoJp font-extrabold';
        else if (ans) cls += 'bg-indigoJp text-white';
        else cls += 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-100';

        b.className = cls;
        b.onclick = () => { state.currentIndex = i; renderCurrentQuestion(); };
        grid.appendChild(b);
      });
    }

    function submitExam() {
      clearInterval(state.timerInterval);
      stopSpeech();
      state.isSubmitted = true;

      let kC = 0, dC = 0, cC = 0;
      state.examQuestions.forEach((q, idx) => {
        if (state.userAnswers[idx] === q.ans) {
          if (q.category === 'kanji') kC++;
          else if (q.category === 'dokkai') dC++;
          else if (q.category === 'choukai') cC++;
        }
      });

      const kS = kC * 5, dS = dC * 5, cS = cC * 5;
      const totalScore = kS + dS + cS; // max 150
      const totalCorrect = kC + dC + cC;
      const isPassed = totalScore >= 120; // 24 out of 30

      state.lastResult = { kC, dC, cC, totalCorrect, kS, dS, cS, totalScore, isPassed };

      renderResults();
      switchView('view-result');
    }

    function renderResults() {
      const res = state.lastResult;
      document.getElementById('res-total-score').textContent = res.totalScore;
      document.getElementById('res-total-correct').textContent = `${res.totalCorrect} dari 30 soal benar`;
      document.getElementById('res-kanji-score').textContent = res.kS;
      document.getElementById('res-kanji-correct').textContent = `${res.kC} / 10 benar`;
      document.getElementById('res-dokkai-score').textContent = res.dS;
      document.getElementById('res-dokkai-correct').textContent = `${res.dC} / 10 benar`;
      document.getElementById('res-choukai-score').textContent = res.cS;
      document.getElementById('res-choukai-correct').textContent = `${res.cC} / 10 benar`;

      const banner = document.getElementById('result-status-banner');
      if (res.isPassed) {
        spawnSakuraPetals(20);
        banner.className = 'rounded-3xl p-6 sm:p-8 border-2 border-goldJp bg-gradient-to-r from-indigoJp via-[#1f3f6d] to-indigoJp text-white shadow-2xl';
        banner.innerHTML = `
          <div class="flex items-center justify-between gap-4">
            <div>
              <span class="px-3 py-1 rounded-full bg-goldJp text-indigoJp font-black text-xs uppercase">🏆 LULUS (合格 • PASSED)</span>
              <h3 class="text-2xl sm:text-3xl font-black font-serifJp mt-2">おめでとうございます！ ${state.candidateName}</h3>
              <p class="text-sm text-slate-200 mt-1">Skor Anda <strong>${res.totalScore} / 150 poin</strong> (Batas Lulus: 120 poin). Pertahankan prestasi ini!</p>
            </div>
            <div class="font-serifJp text-3xl font-black text-goldJp bg-white/10 px-6 py-4 rounded-2xl border border-goldJp">合格</div>
          </div>
        `;
      } else {
        banner.className = 'rounded-3xl p-6 sm:p-8 border-2 border-torii/40 bg-gradient-to-r from-white via-[#FFF6F6] to-amber-50 text-slate-900 shadow-xl';
        banner.innerHTML = `
          <div class="flex items-center justify-between gap-4">
            <div>
              <span class="px-3 py-1 rounded-full bg-torii text-white font-black text-xs uppercase">🔥 BELUM LULUS (不合格)</span>
              <h3 class="text-2xl sm:text-3xl font-black font-serifJp text-indigoJp mt-2">Semangat, ${state.candidateName}!</h3>
              <p class="text-sm text-slate-600 mt-1">Skor Anda <strong>${res.totalScore} / 150 poin</strong> (membutuhkan min. 120 poin). Pelajari pembahasannya di bawah ini dan coba lagi.</p>
            </div>
            <div class="font-serifJp text-3xl font-black text-torii bg-torii/10 px-6 py-4 rounded-2xl border border-torii">不合格</div>
          </div>
        `;
      }

      renderReviewList('all');
    }

    function renderReviewList(filter) {
      const container = document.getElementById('review-list-container');
      container.innerHTML = '';
      const letters = ['A', 'B', 'C', 'D'];

      state.examQuestions.forEach((q, idx) => {
        const userAns = state.userAnswers[idx];
        const isCorrect = userAns === q.ans;
        if (filter === 'wrong' && isCorrect) return;
        if (filter === 'correct' && !isCorrect) return;

        const card = document.createElement('div');
        card.className = `washi-card rounded-2xl p-5 border-l-4 ${isCorrect ? 'border-l-emerald-600' : 'border-l-torii'}`;

        let extra = '';
        if (q.category === 'dokkai') {
          extra = `<div class="bg-slate-50 border rounded-xl p-3 mb-3 text-xs sm:text-sm font-jp text-slate-700 whitespace-pre-line"><strong>${q.title}</strong><br/>${q.passage}</div>`;
        } else if (q.category === 'choukai') {
          extra = `
            <div class="bg-indigoJp/5 border border-indigoJp/20 rounded-xl p-3 mb-3 text-xs">
              <div class="flex items-center justify-between font-bold text-indigoJp mb-1">
                <span>🎧 Transkrip Audio:</span>
                <button type="button" data-replay="${idx}" class="replay-btn px-2.5 py-1 rounded bg-indigoJp text-white hover:bg-indigoLight transition">🔊 Putar Ulang</button>
              </div>
              <p class="font-jp text-slate-800 whitespace-pre-line bg-white p-2 rounded">${q.transcript}</p>
            </div>
          `;
        }

        const optsHtml = q.opts.map((opt, oIdx) => {
          let cls = 'bg-white border-slate-200 text-slate-700';
          let badge = '';
          if (oIdx === q.ans) { cls = 'bg-emerald-50 border-emerald-500 font-bold'; badge = '<span class="ml-auto text-xs text-emerald-700">✓ Kunci</span>'; }
          else if (oIdx === userAns) { cls = 'bg-red-50 border-torii font-bold'; badge = '<span class="ml-auto text-xs text-torii">✗ Jawaban Anda</span>'; }
          return `<div class="px-3 py-2 rounded-xl border ${cls} flex items-center gap-3 text-sm font-jp"><span class="font-sans font-extrabold text-xs px-2 py-0.5 rounded bg-slate-200">${letters[oIdx]}</span><span>${opt}</span>${badge}</div>`;
        }).join('');

        card.innerHTML = `
          <div class="flex items-center justify-between mb-2 text-xs">
            <span class="font-bold text-indigoJp">Soal ${idx + 1} (${q.categoryLabel})</span>
            <span class="font-extrabold ${isCorrect ? 'text-emerald-700' : 'text-torii'}">${isCorrect ? 'BENAR (+5)' : 'SALAH'}</span>
          </div>
          ${extra}
          <p class="font-jp font-bold text-base text-slate-900 mb-3">${q.q}</p>
          <div class="grid sm:grid-cols-2 gap-2 mb-3">${optsHtml}</div>
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs sm:text-sm text-slate-700"><strong>💡 Pembahasan:</strong> ${q.exp}</div>
        `;
        container.appendChild(card);
      });

      // Bind tombol replay di halaman hasil
      document.querySelectorAll('.replay-btn').forEach(b => {
        b.onclick = () => {
          const item = state.examQuestions[parseInt(b.dataset.replay, 10)];
          if (item && item.script) {
              const originalText = b.innerHTML;
              b.innerHTML = '🔊 Memutar...';
              b.disabled = true;
              speakJapaneseScript(item.script, 1.0, () => {
                  b.innerHTML = originalText;
                  b.disabled = false;
              });
          }
        };
      });
    }

    // =========================================================================
    // 5. INIT & LISTENERS
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      spawnSakuraPetals(10);
      generateExamPacket();

      if ('speechSynthesis' in window) {
        window.speechSynthesis.getVoices();
        window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
      }

      document.getElementById('btn-reshuffle').onclick = () => {
        generateExamPacket();
        showToast(`Soal baru dimuat! Paket: ${state.packetCode}`, '🎲');
      };

      document.getElementById('btn-start-exam').onclick = startExam;
      document.getElementById('candidate-name').onkeydown = (e) => { if (e.key === 'Enter') startExam(); };

      document.getElementById('btn-flag-question').onclick = () => {
        state.flaggedQuestions[state.currentIndex] = !state.flaggedQuestions[state.currentIndex];
        renderCurrentQuestion();
      };

      document.getElementById('btn-prev-q').onclick = () => {
        if (state.currentIndex > 0) { state.currentIndex--; renderCurrentQuestion(); }
      };

      document.getElementById('btn-next-q').onclick = () => {
        if (state.currentIndex < 29) { state.currentIndex++; renderCurrentQuestion(); }
        else {
          openConfirmModal('Kumpulkan & Nilai Ujian?', '<p>Pastikan semua jawaban telah terisi dengan baik.</p>', submitExam);
        }
      };

      document.getElementById('btn-finish-exam-top').onclick = () => {
        openConfirmModal('Kumpulkan Ujian Sekarang?', '<p>Anda yakin ingin mengakhiri sesi ujian?</p>', submitExam);
      };
      document.getElementById('btn-submit-exam-side').onclick = () => {
        openConfirmModal('Kumpulkan Ujian Sekarang?', '<p>Anda yakin ingin mengakhiri sesi ujian?</p>', submitExam);
      };

      document.querySelectorAll('.rev-filter-btn').forEach(btn => {
        btn.onclick = () => {
          document.querySelectorAll('.rev-filter-btn').forEach(b => b.className = 'rev-filter-btn px-3 py-1.5 rounded-xl bg-white border border-slate-300 text-slate-700');
          btn.className = 'rev-filter-btn px-3.5 py-1.5 rounded-xl bg-indigoJp text-white';
          renderReviewList(btn.dataset.revFilter);
        };
      });

      document.getElementById('btn-retake-exam').onclick = () => {
        generateExamPacket();
        spawnSakuraPetals(10);
        switchView('view-lobby');
        showToast('Mulai latihan baru!', '🎲');
      };
    });
  </script>
</body>
</html>
