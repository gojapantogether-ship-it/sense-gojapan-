<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JLPT Free Simulator | Akira Course</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            torii: '#BC002D',
            toriiDark: '#920022',
            indigoJp: '#1B365D',
            indigoLight: '#2B4C7E',
            goldJp: '#D4AF37',
            goldLight: '#F3E5AB',
            washi: '#FAF7F0',
            washiDark: '#F0EAE0',
            inkJp: '#1F242D'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Noto Sans JP"', 'sans-serif'],
            jp: ['"Noto Sans JP"', 'sans-serif'],
            serifJp: ['"Noto Serif JP"', 'serif']
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #FAF7F0;
      color: #1F242D;
      background-image:
        radial-gradient(rgba(27, 54, 93, 0.035) 1px, transparent 0),
        radial-gradient(rgba(212, 175, 55, 0.04) 1px, #FAF7F0 0);
      background-size: 28px 28px;
      background-position: 0 0, 14px 14px;
      overflow-x: hidden;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
    }

    .seigaiha-bg {
      background-color: #1B365D;
      background-image:
        radial-gradient(circle at 100% 150%, #1B365D 24%, #244575 25%, #244575 28%, #1B365D 29%, #1B365D 36%, #244575 36%, #244575 40%, transparent 40%, transparent),
        radial-gradient(circle at 0   150%, #1B365D 24%, #244575 25%, #244575 28%, #1B365D 29%, #1B365D 36%, #244575 36%, #244575 40%, transparent 40%, transparent),
        radial-gradient(circle at 50%  100%, #244575 10%, #1B365D 11%, #1B365D 23%, #244575 24%, #244575 30%, #1B365D 31%, #1B365D 43%, #244575 44%, #244575 50%, #1B365D 51%, #1B365D 63%, #244575 64%, #244575 71%, transparent 71%, transparent);
      background-size: 64px 32px;
    }

    .washi-card {
      background: linear-gradient(145deg, #FFFFFF 0%, #FCF9F2 100%);
      box-shadow: 0 10px 30px -5px rgba(27, 54, 93, 0.08), 0 4px 10px -2px rgba(27, 54, 93, 0.04);
      border: 1px solid rgba(212, 175, 55, 0.35);
    }

    .sakura-petal {
      position: fixed;
      top: -40px;
      pointer-events: none;
      z-index: 40;
      animation: fallSakura linear infinite;
    }

    @keyframes fallSakura {
      0% { transform: translateY(-40px) translateX(0px) rotate(0deg) scale(0.9); opacity: 0; }
      10% { opacity: 0.85; }
      50% { transform: translateY(50vh) translateX(45px) rotate(180deg) scale(1); }
      90% { opacity: 0.75; }
      100% { transform: translateY(105vh) translateX(-30px) rotate(360deg) scale(0.85); opacity: 0; }
    }

    .eq-bar {
      width: 4px;
      height: 8px;
      background-color: #D4AF37;
      border-radius: 9999px;
      transition: height 0.15s ease;
    }
    .eq-playing .eq-bar {
      animation: eqBounce 0.6s ease-in-out infinite alternate;
    }
    .eq-playing .eq-bar:nth-child(2) { animation-delay: 0.12s; }
    .eq-playing .eq-bar:nth-child(3) { animation-delay: 0.25s; }
    .eq-playing .eq-bar:nth-child(4) { animation-delay: 0.08s; }
    .eq-playing .eq-bar:nth-child(5) { animation-delay: 0.32s; }
    .eq-playing .eq-bar:nth-child(6) { animation-delay: 0.18s; }

    @keyframes eqBounce {
      0% { height: 6px; background-color: #D4AF37; }
      100% { height: 28px; background-color: #BC002D; }
    }

    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #F0EAE0; }
    ::-webkit-scrollbar-thumb { background: #B8C4D4; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #1B365D; }
  </style>
</head>
<body class="min-h-screen flex flex-col font-sans antialiased selection:bg-torii selection:text-white">

  <!-- Sakura Petals Container -->
  <div id="sakura-container" aria-hidden="true"></div>

  <!-- Toast Notification -->
  <div id="toast-box" class="fixed bottom-5 right-5 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="bg-indigoJp text-white px-5 py-3.5 rounded-xl shadow-2xl border border-goldJp/50 flex items-center gap-3 max-w-sm">
      <span id="toast-icon" class="text-goldJp text-xl">🌸</span>
      <p id="toast-message" class="text-sm font-medium leading-snug"></p>
    </div>
  </div>

  <!-- Confirmation Modal -->
  <div id="confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/65 backdrop-blur-sm p-4">
    <div class="washi-card rounded-2xl max-w-md w-full p-6 sm:p-7 border-2 border-goldJp/60">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-11 h-11 rounded-xl bg-torii/10 text-torii flex items-center justify-center text-xl font-bold">確認</div>
        <div>
          <h3 id="modal-title" class="text-lg font-bold text-indigoJp">Kumpulkan Ujian Sekarang?</h3>
          <p class="text-xs text-slate-500 font-jp">試験を終了して採点しますか？</p>
        </div>
      </div>
      <div id="modal-body" class="text-sm text-slate-700 space-y-2.5 mb-6 bg-washiDark/70 p-4 rounded-xl border border-slate-200"></div>
      <div class="flex flex-col sm:flex-row gap-3 justify-end">
        <button id="modal-cancel-btn" type="button" class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-100 transition">Kembali</button>
        <button id="modal-confirm-btn" type="button" class="px-5 py-2.5 rounded-xl bg-torii text-white font-bold text-sm hover:bg-toriiDark shadow-lg shadow-torii/25 transition">Ya, Kumpulkan & Nilai</button>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- VIEW 1: LOBBY UJIAN (HALAMAN AWAL)                                    -->
  <!-- ===================================================================== -->
  <main id="view-lobby" class="flex-1 flex flex-col">
    <header class="seigaiha-bg text-white border-b-4 border-goldJp shadow-lg">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-torii flex items-center justify-center shadow-md border border-goldJp/60 shrink-0">
            <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M2 4h20v2.5H2V4zm2 3.5h16v2H4v-2zM6.5 9.5h2.5V21H6.5V9.5zm8.5 0h2.5V21H15V9.5zM11 6.5h2v3h-2v-3z"/>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold tracking-widest uppercase px-2 py-0.5 rounded bg-goldJp/20 text-goldLight border border-goldJp/40">JLPT Free Edition</span>
              <span class="text-xs text-slate-300 font-jp">日本語無料模擬試験</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight font-serifJp">Akira Course <span class="text-goldJp">JLPT Free</span> Simulator</h1>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur px-3.5 py-2 rounded-xl border border-white/15 text-xs sm:text-sm">
          <span>Total Ujian: <strong class="text-goldLight">30 Soal Proporsional</strong></span>
        </div>
      </div>
    </header>

    <section class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-8 sm:py-12 flex-1">
      <div class="grid lg:grid-cols-12 gap-8 items-start">
        <!-- Left Info -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-torii/10 text-torii border border-torii/25 text-xs font-bold">
            <span>⛩️</span>
            <span>Simulasi Ujian Gratis • Level N5–N4 / JFT-Basic</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-black text-indigoJp leading-tight font-serifJp">
            Latihan Ujian Bahasa Jepang <span class="text-torii underline decoration-goldJp decoration-4 underline-offset-4">Gratis & Interaktif</span>
          </h2>

          <p class="text-slate-600 text-base leading-relaxed">
            Simulasi ini menyajikan <strong>30 soal pilihan ganda</strong> yang diacak otomatis (10 Kanji/Kosakata, 10 Dokkai/Membaca, dan 10 Choukai/Mendengarkan dengan audio TTS native). Dilengkapi timer dan pembahasan lengkap di akhir.
          </p>

          <div class="grid sm:grid-cols-3 gap-4 pt-1">
            <div class="washi-card rounded-2xl p-4 border-t-4 border-t-indigoJp">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold uppercase tracking-wider text-indigoJp bg-indigoJp/10 px-2 py-0.5 rounded-md">Bagian 1</span>
                <span class="font-serifJp font-bold text-indigoJp">文字・語彙</span>
              </div>
              <h3 class="font-bold text-slate-800 text-sm">Kanji & Kosakata</h3>
              <p class="text-xs text-slate-500 mt-1">10 soal pilihan ganda.</p>
              <div class="mt-3 pt-2.5 border-t border-slate-200/80 flex justify-between text-xs font-semibold">
                <span class="text-slate-500">Soal 1–10</span>
                <span class="text-indigoJp">50 Poin</span>
              </div>
            </div>

            <div class="washi-card rounded-2xl p-4 border-t-4 border-t-goldJp">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-800 bg-goldJp/25 px-2 py-0.5 rounded-md">Bagian 2</span>
                <span class="font-serifJp font-bold text-amber-800">読解</span>
              </div>
              <h3 class="font-bold text-slate-800 text-sm">Dokkai (Membaca)</h3>
              <p class="text-xs text-slate-500 mt-1">10 soal pemahaman teks.</p>
              <div class="mt-3 pt-2.5 border-t border-slate-200/80 flex justify-between text-xs font-semibold">
                <span class="text-slate-500">Soal 11–20</span>
                <span class="text-amber-800">50 Poin</span>
              </div>
            </div>

            <div class="washi-card rounded-2xl p-4 border-t-4 border-t-torii">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold uppercase tracking-wider text-torii bg-torii/10 px-2.5 py-0.5 rounded-md">Bagian 3</span>
                <span class="font-serifJp font-bold text-torii">聴解</span>
              </div>
              <h3 class="font-bold text-slate-800 text-sm">Choukai (Listening)</h3>
              <p class="text-xs text-slate-500 mt-1">10 soal audio (limit 2x putar).</p>
              <div class="mt-3 pt-2.5 border-t border-slate-200/80 flex justify-between text-xs font-semibold">
                <span class="text-slate-500">Soal 21–30</span>
                <span class="text-torii">50 Poin</span>
              </div>
            </div>
          </div>

          <div class="washi-card rounded-2xl p-5 flex items-center gap-4 bg-gradient-to-r from-indigoJp/5 via-white to-goldJp/10">
            <div class="w-14 h-14 rounded-2xl bg-indigoJp text-goldJp flex flex-col items-center justify-center shrink-0 shadow">
              <span class="text-xs font-bold">SKOR</span>
              <span class="text-lg font-black leading-none">150</span>
            </div>
            <div>
              <h4 class="font-bold text-indigoJp text-sm sm:text-base">Kriteria Kelulusan (合格基準)</h4>
              <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
                Setiap jawaban benar bernilai <strong>5 poin</strong>. Skor <strong class="text-emerald-700">≥ 120 poin (min. 24 soal benar)</strong> dinyatakan <span class="font-bold text-emerald-700">LULUS (合格)</span>.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Registration Box -->
        <div class="lg:col-span-5">
          <div class="washi-card rounded-3xl p-6 sm:p-8 border-2 border-goldJp/50 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-28 h-28 bg-torii/5 rounded-bl-full pointer-events-none"></div>

            <div class="flex items-center justify-between mb-5">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-torii">Registrasi Peserta</span>
                <h3 class="text-xl font-extrabold text-indigoJp font-serifJp">Mulai Ujian Gratis</h3>
              </div>
              <span class="font-serifJp text-2xl text-goldJp font-black">無料</span>
            </div>

            <div class="space-y-5">
              <div>
                <label for="candidate-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Nama Lengkap Peserta <span class="text-torii">*</span>
                </label>
                <input
                  type="text"
                  id="candidate-name"
                  placeholder="Contoh: Siti Rahmawati"
                  maxlength="48"
                  class="w-full px-4 py-3 rounded-xl bg-white border-2 border-slate-200 focus:border-indigoJp focus:outline-none text-slate-800 font-semibold transition"
                />
                <p id="name-error" class="text-xs text-torii font-semibold mt-1 hidden">
                  Silakan masukkan nama lengkap Anda terlebih dahulu.
                </p>
              </div>

              <div class="bg-washiDark/80 rounded-2xl p-4 border border-goldJp/40">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-bold text-indigoJp">🎲 Status Soal</span>
                  <span id="packet-code" class="text-xs font-mono font-bold px-2.5 py-0.5 rounded bg-indigoJp text-goldLight">PKT-FREE-30</span>
                </div>
                <p class="text-xs text-slate-600 mb-3">30 soal diacak otomatis dari bank soal latihan JLPT.</p>
                <button
                  type="button"
                  id="btn-reshuffle"
                  class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-indigoJp/5 text-indigoJp border border-indigoJp/30 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition"
                >
                  <svg id="shuffle-icon" class="w-4 h-4 text-torii transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                  </svg>
                  <span>Acak Ulang Soal</span>
                </button>
              </div>

              <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center gap-2.5">
                  <span class="text-lg">⏱️</span>
                  <div>
                    <div class="text-slate-400">Waktu Ujian</div>
                    <div class="font-bold text-slate-800">40 Menit</div>
                  </div>
                </div>
                <div class="bg-white p-3 rounded-xl border border-slate-200 flex items-center gap-2.5">
                  <span class="text-lg">🎧</span>
                  <div>
                    <div class="text-slate-400">Audio Choukai</div>
                    <div class="font-bold text-slate-800">Maks 2x Putar</div>
                  </div>
                </div>
              </div>

              <button
                type="button"
                id="btn-start-exam"
                class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-torii to-toriiDark hover:from-toriiDark hover:to-torii text-white font-extrabold text-base shadow-xl shadow-torii/30 flex items-center justify-center gap-3 transition"
              >
                <span>Mulai Ujian Gratis</span>
                <span class="font-jp text-sm bg-white/20 px-2 py-0.5 rounded">試験開始</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ===================================================================== -->
  <!-- VIEW 2: RUANG UJIAN CBT (EXAM INTERFACE)                              -->
  <!-- ===================================================================== -->
  <section id="view-exam" class="hidden flex-1 flex-col min-h-screen">
    <header class="bg-indigoJp text-white border-b-4 border-goldJp sticky top-0 z-30 shadow-md">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-torii flex items-center justify-center font-serifJp font-black text-white border border-goldJp/60 shrink-0">試</div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-goldLight">JLPT Free CBT</span>
              <span id="exam-id-display" class="text-[11px] font-mono bg-white/10 px-2 py-0.5 rounded text-slate-200">ID: JLPT-0000</span>
            </div>
            <div class="text-xs sm:text-sm font-bold truncate max-w-[180px] sm:max-w-xs" id="exam-candidate-display">Peserta Ujian</div>
          </div>
        </div>

        <div id="active-section-badge" class="hidden md:flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-goldJp/40 text-xs font-bold">
          <span class="w-2 h-2 rounded-full bg-goldJp"></span>
          <span id="active-section-text">Bagian 1: 文字・語彙</span>
        </div>

        <div class="flex items-center gap-2.5 sm:gap-4">
          <div id="timer-box" class="bg-slate-900/60 border border-goldJp/50 px-3.5 py-1.5 rounded-xl flex items-center gap-2">
            <span class="text-xs text-slate-300 hidden sm:inline">Waktu:</span>
            <span id="timer-display" class="font-mono text-base sm:text-lg font-extrabold text-goldLight tracking-wider">40:00</span>
          </div>
          <button type="button" id="btn-finish-exam-top" class="px-3.5 py-2 rounded-xl bg-torii hover:bg-toriiDark text-white text-xs sm:text-sm font-bold shadow transition">Selesai</button>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto w-full px-3 sm:px-6 py-5 flex-1 grid lg:grid-cols-12 gap-6 items-start">
      <div class="lg:col-span-8 space-y-5">
        <div class="washi-card rounded-2xl p-5 sm:p-7 border border-slate-200/90">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-slate-200">
            <div class="flex items-center gap-2.5">
              <span id="q-number-badge" class="px-3.5 py-1.5 rounded-xl bg-indigoJp text-white font-extrabold text-sm">Soal 1 / 30</span>
              <span id="q-category-badge" class="px-3 py-1 rounded-lg bg-goldJp/20 text-amber-900 font-bold text-xs font-jp">文字・語彙</span>
              <span class="text-xs text-slate-400 font-semibold hidden sm:inline">• 5 Poin</span>
            </div>

            <button type="button" id="btn-flag-question" class="px-3.5 py-1.5 rounded-xl border border-slate-300 text-slate-600 hover:border-goldJp hover:text-amber-800 text-xs font-bold flex items-center gap-1.5 transition">
              <span id="flag-icon">🏳️</span>
              <span id="flag-text">Tandai Ragu-ragu</span>
            </button>
          </div>

          <div id="question-stimulus-area" class="mb-5"></div>

          <div class="mb-6">
            <p id="question-prompt-jp" class="font-jp text-lg sm:text-xl font-bold text-slate-900 leading-relaxed"></p>
            <p id="question-subprompt" class="text-xs text-slate-500 mt-1.5"></p>
          </div>

          <div id="options-container" class="space-y-3"></div>
        </div>

        <div class="flex items-center justify-between gap-3">
          <button type="button" id="btn-prev-q" class="px-5 py-3 rounded-xl bg-white border border-slate-300 text-slate-700 font-bold text-sm hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-2 shadow-sm transition">
            <span>←</span><span>Sebelumnya</span>
          </button>
          <button type="button" id="btn-next-q" class="px-6 py-3 rounded-xl bg-indigoJp hover:bg-indigoLight text-white font-bold text-sm flex items-center gap-2 shadow-md transition">
            <span>Berikutnya</span><span>→</span>
          </button>
        </div>
      </div>

      <aside class="lg:col-span-4 space-y-4">
        <div class="washi-card rounded-2xl p-4 sm:p-5 border border-goldJp/40">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-extrabold text-indigoJp text-sm flex items-center gap-2"><span>📋</span> Navigasi Soal</h3>
            <span id="answered-counter" class="text-xs font-bold px-2.5 py-1 rounded-full bg-indigoJp/10 text-indigoJp">Terjawab: 0 / 30</span>
          </div>

          <div id="nav-grid" class="grid grid-cols-6 sm:grid-cols-10 lg:grid-cols-6 gap-2 max-h-[300px] overflow-y-auto pr-1"></div>

          <div class="mt-4 pt-3 border-t border-slate-200 grid grid-cols-2 gap-2 text-[11px] text-slate-600 font-medium">
            <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-indigoJp inline-block"></span><span>Terjawab</span></div>
            <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-goldJp inline-block"></span><span>Ragu-ragu</span></div>
            <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-white border-2 border-torii inline-block"></span><span>Aktif</span></div>
