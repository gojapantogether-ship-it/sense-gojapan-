      const c = fisherYatesShuffle(choukaiBank).slice(0, 10).map(item => ({ ...item, category: 'choukai', categoryLabel: '聴解 (Choukai)' }));

      state.examQuestions = [...k, ...d, ...c];
      state.packetCode = `PKT-FREE-${Math.floor(1000 + Math.random() * 9000)}`;
      document.getElementById('packet-code').textContent = state.packetCode;
    }

