    function fisherYatesShuffle(arr) {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function generateExamPacket() {
      const k = fisherYatesShuffle(kanjiBank).slice(0, 10).map(item => ({ ...item, category: 'kanji', categoryLabel: '文字・語彙 (Kanji)' }));
